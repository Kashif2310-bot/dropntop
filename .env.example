# Copy this to .env.local and fill in real values. Never commit .env.local.

# Get test keys from the Razorpay dashboard (Settings > API Keys) after
# signing up at https://razorpay.com — test mode needs no KYC, live mode
# does. Without these, /api/billing/create-order fails closed with a clear
# error and the rest of the site works normally (payments are the only
# feature that needs them).
RAZORPAY_KEY_ID=rzp_test_TWtmuQlDsZfrPO
RAZORPAY_KEY_SECRET=RSghLYFWlNkg3SREqFwfN4Sx

# A secret you make up yourself — required in the x-admin-secret header to
# call POST /api/admin/cleanup. Without this set, that endpoint always
# refuses (safe default, not a bug).
ADMIN_CLEANUP_SECRET=
